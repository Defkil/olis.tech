---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { type BlogCollectionKey, collections, type BlogPost } from '../../content.config';

export async function getStaticPaths() {
  const allPosts = await Promise.all(Object.keys(collections).map(async (category) => {
    const posts = await getCollection(category as BlogCollectionKey);
    return posts.map((post: BlogPost) => ({
      params: { category, slug: post.id }, props: post
    }));
  }));

  return allPosts.flat();
}

type Props = CollectionEntry<BlogCollectionKey>;

const post: Props = Astro.props;
const { Content } = await render(post);
---

<PostLayout {...post.data}>
  <Content />
</PostLayout>
