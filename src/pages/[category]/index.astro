---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { type BlogCollectionKey, blogCollections } from '../../content/config';
import DefaultLayout from '../../layouts/DefaultLayout.astro';

export async function getStaticPaths() {
  return Object.keys(blogCollections).map((category) => ({
    params: { category }
  }));
}

const { category } = Astro.params as { category: BlogCollectionKey };
const posts = (await getCollection(category)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<DefaultLayout title={category.charAt(0).toUpperCase() + category.slice(1)} description={`Everything about ${category}`}>
  <section>
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/${post.collection}/${post.slug}/`}>
            <img width={720} height={360} src={post.data.heroImage} alt="" />
            <h4 class="title">{post.data.title}</h4>
            <p class="date">
              <FormattedDate date={new Date(post.data.pubDate)} />
            </p>
          </a>
        </li>))}
    </ul>
  </section>
</DefaultLayout>
