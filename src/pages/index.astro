---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { type BlogCollectionKey, blogCollections, type BlogPost } from '../content/config';
import DefaultLayout from '../layouts/DefaultLayout.astro';

const allPosts = await Promise.all(Object.keys(blogCollections).map(async (collection) => {
  return await getCollection(collection as BlogCollectionKey);
}));

const posts = allPosts
  .flat()
  .sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<DefaultLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <section>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/${post.collection}/${post.slug}/`}>
              <img width={720} height={360} src={post.data.heroImage} alt="" />
              <h4 class="title">{post.data.title}</h4>
              <p class="date">
                <FormattedDate date={new Date(post.data.pubDate)} />
              </p>
            </a>
          </li>))}
      </ul>
    </section>
  </main>
</DefaultLayout>
