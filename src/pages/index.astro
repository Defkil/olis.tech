---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { type BlogCollectionKey, blogCollections, type BlogPost } from '../content/config';
import DefaultLayout from '../layouts/DefaultLayout.astro';
import ContentGrid from '../components/content-grid/ContentGrid.astro';

const allPosts = await Promise.all(Object.keys(blogCollections).map(async (collection) => {
  return await getCollection(collection as BlogCollectionKey);
}));

const posts = allPosts
  .flat()
  .sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<DefaultLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <ContentGrid page="1" />
</DefaultLayout>
